<screen>
	<view
		extends="lv_obj"
		style_bg_color="0x121824"
		style_bg_opa="255"
		flex_flow="column"
		style_flex_main_place="center"
		style_flex_cross_place="center"
		style_flex_track_place="center"
		style_pad_row="45"
	>
		<lv_label
			name="head_label"
			text="Red Green Blue Mixer"
			style_text_font="title_large"
			style_text_align="center"
			style_text_color="0xFAFAFA"
		/>
		<!-- Red row: slider + value label side by side -->
		<lv_obj
			width="90%"
			height="content"
			style_bg_opa="0"
			style_border_width="0"
			style_pad_top="0"
			style_pad_bottom="0"
			style_pad_right="0"
			style_pad_left="14"
			flex_flow="row"
			style_flex_cross_place="center"
			style_pad_column="10"
		>
			<lv_slider
				name="red_slider"
				flex_grow="1"
				min_value="0"
				max_value="255"
				bind_value="red_val"
				style_bg_color="0x330000"
				style_bg_opa="255"
				style_bg_color-indicator="0xFF0000"
				style_bg_opa-indicator="255"
				style_bg_color-knob="0xFF0000"
				style_bg_opa-knob="255"
			/>
			<lv_label
				name="red_label"
				width="60"
				bind_text="red_val"
				bind_text-fmt="%3d"
				style_text_font="body_medium"
				style_text_align="center"
				style_text_color="0xFAFAFA"
			/>
		</lv_obj>

		<!-- Green row: slider + value label side by side -->
		<lv_obj
			width="90%"
			height="content"
			style_bg_opa="0"
			style_border_width="0"
			style_pad_top="0"
			style_pad_bottom="0"
			style_pad_right="0"
			style_pad_left="14"
			flex_flow="row"
			style_flex_cross_place="center"
			style_pad_column="10"
		>
			<lv_slider
				name="green_slider"
				flex_grow="1"
				min_value="0"
				max_value="255"
				bind_value="green_val"
				style_bg_color="0x003300"
				style_bg_opa="255"
				style_bg_color-indicator="0x00FF00"
				style_bg_opa-indicator="255"
				style_bg_color-knob="0x00FF00"
				style_bg_opa-knob="255"
			/>
			<lv_label
				name="green_label"
				width="60"
				bind_text="green_val"
				bind_text-fmt="%3d"
				style_text_font="body_medium"
				style_text_align="center"
				style_text_color="0xFAFAFA"
			/>
		</lv_obj>

		<!-- Blue row: slider + value label side by side -->
		<lv_obj
			width="90%"
			height="content"
			style_bg_opa="0"
			style_border_width="0"
			style_pad_top="0"
			style_pad_bottom="0"
			style_pad_right="0"
			style_pad_left="14"
			flex_flow="row"
			style_flex_cross_place="center"
			style_pad_column="10"
		>
			<lv_slider
				name="blue_slider"
				flex_grow="1"
				min_value="0"
				max_value="255"
				bind_value="blue_val"
				style_bg_color="0x000033"
				style_bg_opa="255"
				style_bg_color-indicator="0x0000FF"
				style_bg_opa-indicator="255"
				style_bg_color-knob="0x0000FF"
				style_bg_opa-knob="255"
			/>
			<lv_label
				name="blue_label"
				width="60"
				bind_text="blue_val"
				bind_text-fmt="%3d"
				style_text_font="body_medium"
				style_text_align="center"
				style_text_color="0xFAFAFA"
			/>
		</lv_obj>
		<lv_obj name="rgb_mix_rectangle" width="90%" height="30%" style_bg_color="0x000000" />
	</view>
</screen>
