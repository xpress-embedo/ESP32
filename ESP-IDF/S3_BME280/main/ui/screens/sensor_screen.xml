<screen>
	<view
		extends="lv_obj"
		width="100%"
		height="100%"
		style_bg_color="0x0B0F19"
		style_bg_opa="255"
		flex_flow="column"
		style_flex_main_place="start"
		style_flex_cross_place="center"
		style_pad_top="18"
		style_pad_bottom="18"
		style_pad_left="24"
		style_pad_right="24"
		style_pad_row="20"
	>
		<!-- Top Bar Status Badge -->
		<lv_obj
			width="100%"
			height="content"
			style_bg_opa="0"
			style_border_width="0"
			style_pad_all="0"
			flex_flow="row"
			style_flex_main_place="start"
			style_flex_cross_place="center"
		>
			<lv_obj
				width="content"
				height="content"
				style_bg_color="0x0E2A1E"
				style_bg_opa="220"
				style_border_width="1"
				style_border_color="0x2ECC71"
				style_radius="20"
				style_pad_top="6"
				style_pad_bottom="6"
				style_pad_left="14"
				style_pad_right="14"
				style_pad_column="8"
				flex_flow="row"
				style_flex_cross_place="center"
			>
				<lv_obj
					width="10"
					height="10"
					style_radius="10"
					style_bg_color="0x2ECC71"
					style_bg_opa="255"
					style_border_width="0"
				/>
				<lv_label
					name="status_label"
					text="BME280: Connected"
					style_text_font="body_medium"
					style_text_color="0x2ECC71"
				/>
			</lv_obj>
		</lv_obj>

		<!-- Main Cards Row: All 3 Cards using <sensor_card> -->
		<lv_obj
			width="100%"
			height="content"
			style_bg_opa="0"
			style_border_width="0"
			flex_flow="row"
			style_flex_main_place="space_between"
			style_flex_cross_place="start"
			style_pad_column="20"
		>
			<!-- Card 1: Temperature (Amber) -->
			<sensor_card
				value_text="temp_str"
				img_src="thermometer_img"
				status_label_text="temp_status_str"
				status_text_color="0x8FA0B8"
				card_title_text="Temperature Card"
				theme_color="0xF39C12"
			/>

			<!-- Card 2: Humidity (Cyan) -->
			<sensor_card
				value_text="hum_str"
				img_src="humidity_img"
				status_label_text="hum_status_str"
				status_text_color="0x00E5FF"
				card_title_text="Humidity Card"
				theme_color="0x00E5FF"
			/>

			<!-- Card 3: Pressure (Purple) -->
			<sensor_card
				value_text="press_str"
				img_src="pressure_img"
				status_label_text="press_status_str"
				status_text_color="0xBD10E0"
				card_title_text="Barometric Pressure Card"
				theme_color="0xBD10E0"
			/>
		</lv_obj>
	</view>
</screen>
